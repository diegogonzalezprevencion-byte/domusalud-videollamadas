# Solo referencia. No escribas aquí tus claves reales ni subas un .env con secretos a GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=TU_API_KEY
LIVEKIT_API_SECRET=TU_API_SECRET

# Dos correos REALES y DIFERENTES, configurados SOLO en Vercel como Secret.
# Los dos inicios de sesión muestran dgonzalez, pero son dos identidades de Supabase.
DOMUS_ADMIN_EMAIL=administrador@tu-dominio.cl
DOMUS_USER_EMAIL=usuario@tu-dominio.cl
